# Django
DJANGO_SECRET_KEY=replace-with-at-least-50-random-characters
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=1

# MySQL
MYSQL_DATABASE=chaincontrol
MYSQL_USER=chaincontrol
MYSQL_PASSWORD=chaincontrol
MYSQL_ROOT_PASSWORD=root
MYSQL_HOST=mysql
MYSQL_PORT=3306

# Redis / Celery
REDIS_URL=redis://redis:6379/0

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=replace-me
MINIO_SECRET_KEY=replace-me-with-a-long-secret
MINIO_BUCKET=chaincontrol-assets
MINIO_SECURE=false

# 32-byte key, base64 encoded. Generate independently for each environment.
ASSET_MASTER_KEY_BASE64=replace-with-base64-encoded-32-byte-key

# Besu / contract integration
WEB3_PROVIDER_URL=http://besu-validator-1:8545
CHAIN_ID=1337
BLOCKCHAIN_CONFIRMATIONS=1
BLOCKCHAIN_SIGNER_ADDRESS=
BLOCKCHAIN_SIGNER_PRIVATE_KEY=
IDENTITY_REGISTRY_ADDRESS=
TRUST_ACCESS_MANAGER_ADDRESS=
ASSET_REGISTRY_ADDRESS=

# Frontend
VITE_API_URL=http://localhost/api/v1

